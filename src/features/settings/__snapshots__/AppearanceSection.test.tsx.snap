// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AppearanceSection two-theme snapshot walkthrough > matches the section snapshot in dark and light themes > dark theme 1`] = `"<html style="--accent: #7c8cff;" data-theme="dark"><head></head><body><div><div data-testid="appearance-section" class="flex min-h-0 flex-1 flex-col"><div class="shrink-0 border-b border-bg-sunken px-4 py-3"><h2 class="text-sm font-semibold">Appearance</h2><p class="text-xs text-fg-secondary">Theme, accent color, UI scale and OLED black.</p></div><div class="min-h-0 flex-1 overflow-y-auto p-4"><div class="border-b border-bg-sunken py-3"><p class="text-xs font-medium">Theme</p><div class="mt-2 flex gap-2"><button type="button" data-testid="theme-dark" aria-pressed="false" class="rounded-md border px-3 py-1.5 text-xs outline-none transition-colors border-bg-sunken bg-bg-sunken text-fg-secondary hover:text-fg-primary">Dark</button><button type="button" data-testid="theme-light" aria-pressed="false" class="rounded-md border px-3 py-1.5 text-xs outline-none transition-colors border-bg-sunken bg-bg-sunken text-fg-secondary hover:text-fg-primary">Light</button><button type="button" data-testid="theme-system" aria-pressed="true" class="rounded-md border px-3 py-1.5 text-xs outline-none transition-colors border-accent bg-accent-soft text-fg-primary">System</button></div></div><div class="border-b border-bg-sunken py-3"><p class="text-xs font-medium">Accent color</p><p class="mt-0.5 text-xs text-fg-secondary">Pick a preset or set a custom color.</p><div class="mt-2 flex flex-wrap items-center gap-2"><button type="button" data-testid="accent-preset-indigo" aria-pressed="true" aria-label="Indigo" title="Indigo" class="h-7 w-7 rounded-full outline-none transition-shadow ring-2 ring-fg-primary ring-offset-2 ring-offset-bg-base" style="background: rgb(124, 140, 255);"></button><button type="button" data-testid="accent-preset-emerald" aria-pressed="false" aria-label="Emerald" title="Emerald" class="h-7 w-7 rounded-full outline-none transition-shadow hover:ring-2 hover:ring-fg-faint hover:ring-offset-2 hover:ring-offset-bg-base" style="background: rgb(52, 211, 153);"></button><button type="button" data-testid="accent-preset-amber" aria-pressed="false" aria-label="Amber" title="Amber" class="h-7 w-7 rounded-full outline-none transition-shadow hover:ring-2 hover:ring-fg-faint hover:ring-offset-2 hover:ring-offset-bg-base" style="background: rgb(251, 191, 36);"></button><button type="button" data-testid="accent-preset-coral" aria-pressed="false" aria-label="Coral" title="Coral" class="h-7 w-7 rounded-full outline-none transition-shadow hover:ring-2 hover:ring-fg-faint hover:ring-offset-2 hover:ring-offset-bg-base" style="background: rgb(248, 113, 113);"></button><button type="button" data-testid="accent-preset-cyan" aria-pressed="false" aria-label="Cyan" title="Cyan" class="h-7 w-7 rounded-full outline-none transition-shadow hover:ring-2 hover:ring-fg-faint hover:ring-offset-2 hover:ring-offset-bg-base" style="background: rgb(34, 211, 238);"></button><button type="button" data-testid="accent-preset-purple" aria-pressed="false" aria-label="Purple" title="Purple" class="h-7 w-7 rounded-full outline-none transition-shadow hover:ring-2 hover:ring-fg-faint hover:ring-offset-2 hover:ring-offset-bg-base" style="background: rgb(192, 132, 252);"></button><div data-testid="accent-custom" class="flex items-center gap-1.5" data-custom="false"><input type="color" class="h-7 w-9 cursor-pointer rounded-md border border-bg-sunken bg-transparent p-0.5" aria-label="Custom color" title="Custom color"><input type="text" data-testid="accent-custom-input" class="w-20 rounded-md border border-bg-sunken bg-bg-sunken px-2 py-1 font-code text-xs text-fg-secondary outline-none focus:border-accent focus:text-fg-primary" spellcheck="false" aria-label="Custom color"></div></div></div><div class="border-b border-bg-sunken py-3"><p class="text-xs font-medium">UI scale</p><p class="mt-0.5 text-xs text-fg-secondary">Adjust the size of the entire interface (90%–160%).</p><div class="mt-2 flex items-center gap-3"><input type="range" data-testid="ui-scale-slider" class="w-48 cursor-pointer accent-accent" min="0.9" max="1.6" step="0.05" aria-label="UI scale"><span data-testid="ui-scale-value" class="shrink-0 font-code text-xs text-fg-secondary">110%</span></div></div><div class="py-3" data-testid="theme-server-override"><p class="text-xs font-medium">Server override</p><p class="mt-0.5 text-xs text-fg-secondary">This server keeps its own theme instead of following the app.</p><div class="mt-2 flex flex-wrap gap-2"><button type="button" data-testid="theme-server-follow" aria-pressed="true" class="rounded-md border px-3 py-1.5 text-xs outline-none transition-colors border-accent bg-accent-soft text-fg-primary">Follow global</button><button type="button" data-testid="theme-server-dark" aria-pressed="false" class="rounded-md border px-3 py-1.5 text-xs outline-none transition-colors border-bg-sunken bg-bg-sunken text-fg-secondary hover:text-fg-primary">Dark</button><button type="button" data-testid="theme-server-light" aria-pressed="false" class="rounded-md border px-3 py-1.5 text-xs outline-none transition-colors border-bg-sunken bg-bg-sunken text-fg-secondary hover:text-fg-primary">Light</button><button type="button" data-testid="theme-server-system" aria-pressed="false" class="rounded-md border px-3 py-1.5 text-xs outline-none transition-colors border-bg-sunken bg-bg-sunken text-fg-secondary hover:text-fg-primary">System</button></div></div></div></div></div></body></html>"`;

