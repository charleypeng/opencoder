{
  "schemaVersion": 1,
  "id": "dev.opencoder.orbit",
  "name": "Orbit Helper",
  "version": "1.0.0",
  "author": "OpenCoder contributors",
  "license": "MIT",
  "description": "A friendly retro helper robot with an expressive LED face.",
  "preview": "preview.png",
  "renderer": {
    "type": "sprite",
    "pixelated": false,
    "canvas": { "width": 160, "height": 160 },
    "states": {
      "idle": { "asset": "assets/idle-frames.png", "frames": 4, "fps": 3, "loop": true },
      "working": { "asset": "assets/working-frames.png", "frames": 4, "fps": 6, "loop": true },
      "waiting": { "asset": "assets/waiting.png", "frames": 1, "fps": 1, "loop": true },
      "success": { "asset": "assets/success.png", "frames": 1, "fps": 1, "loop": false },
      "error": { "asset": "assets/error.png", "frames": 1, "fps": 1, "loop": false },
      "attention": { "asset": "assets/attention.png", "frames": 1, "fps": 1, "loop": false }
    },
    "reactions": {
      "hover": { "asset": "assets/idle-frames.png", "startFrame": 1, "frames": 1, "fps": 8 },
      "tap": { "asset": "assets/idle-frames.png", "startFrame": 2, "frames": 1, "fps": 8 },
      "press": { "asset": "assets/working-frames.png", "startFrame": 1, "frames": 1, "fps": 8 },
      "dragStart": { "asset": "assets/working-frames.png", "startFrame": 2, "frames": 1, "fps": 8 },
      "drop": { "asset": "assets/idle-frames.png", "startFrame": 3, "frames": 1, "fps": 8 }
    }
  }
}
